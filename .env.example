# Configuration Base de Données
POSTGRES_PASSWORD=password123
POSTGRES_DB=honoris_chatbot
POSTGRES_USER=postgres

# Configuration Django
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Configuration Ollama LLM
OLLAMA_API_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# Configuration Redis
REDIS_URL=redis://redis:6379/0

# Configuration Frontend React
REACT_APP_API_URL=http://localhost:8000
REACT_APP_CHATBOT_URL=http://localhost:8000/api/chatbot

# Configuration Production
ENVIRONMENT=development
TAG=latest

# Monitoring (optionnel)
GRAFANA_PASSWORD=admin123

# Configuration Email (optionnel)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Configuration JWT
JWT_SECRET_KEY=jwt-secret-change-me-in-production
JWT_ACCESS_TOKEN_LIFETIME=3600

# Configuration FAISS (vector store)
FAISS_INDEX_PATH=/app/faiss_index
EMBEDDINGS_MODEL=all-MiniLM-L6-v2

# Configuration Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# Configuration Upload
MAX_UPLOAD_SIZE=100MB
ALLOWED_UPLOAD_EXTENSIONS=pdf,doc,docx,txt
